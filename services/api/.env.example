# --- Shared variables (names are fixed) ---
# Must be a pk_live_ key: pk_test_ keys only return canned sandbox fixtures.
PANTA_API_KEY=
PANTA_BASE_URL=https://live-api.panta.market/api/v1
# Only "live" is implemented. Panta trades on Solana mainnet, so buys spend real USDC.
PANTA_MODE=live
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SOLANA_RPC_URL=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Additional variables this service needs ---
# Supabase Postgres connection string (Project Settings -> Database). Required.
DATABASE_URL=
# privy (default) verifies real Privy tokens. dev accepts "Bearer dev:<privy_user_id>"
# for curl testing and must never be used in a deployed environment.
AUTH_MODE=privy
PORT=8080
