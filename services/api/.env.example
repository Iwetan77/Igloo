# --- Shared variables (names are fixed) ---
# Must be a pk_live_ key: pk_test_ keys only return canned sandbox fixtures.
PANTA_API_KEY=
PANTA_BASE_URL=https://live-api.panta.market/api/v1
# Only "live" is implemented. Panta trades on Solana mainnet, so buys spend real USDC.
PANTA_MODE=live
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SOLANA_RPC_URL=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Additional variables this service needs ---
# Supabase Postgres connection string. Required. Use the transaction pooler (port 6543)
# with sslmode=require: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# (the session pooler on 5432 timed out during TLS from our dev network).
DATABASE_URL=
# privy (default) verifies real Privy tokens. dev accepts "Bearer dev:<privy_user_id>"
# for curl testing and must never be used in a deployed environment.
AUTH_MODE=privy
PORT=8080
# Bearer token for GET /api/v1/internal/refresh-catalog (Vercel Cron and the
# GitHub Action send it). Any long random string; leave empty to disable the route.
CRON_SECRET=
